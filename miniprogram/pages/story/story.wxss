/* pages/story/story.wxss */

/* ==================== 容器与布局 ==================== */
page {
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background-color: #000000;
}

.story-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background-color: #000000;
}

/* 开场动画容器 */
.opening-animation-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 100;
  overflow: hidden;
  background-color: #000000;
}

.opening-animation-image {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  filter: blur(90px) brightness(0.4);
  transform: scale(1.3);
}

.opening-animation-container.active .opening-animation-image {
  animation: openingImageFadeIn 2.5s ease-out forwards;
}

.opening-gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 400%;
  height: 100%;
  background: linear-gradient(225deg, #000 25%, transparent 100%);
  transform: translateX(-65%);
  opacity: 1;
  z-index: 10;
  pointer-events: none;
}

.opening-gradient-overlay.active {
  animation: gradientSlide 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards 1.2s;
}

/* ==================== 背景容器 ==================== */
.story-background {
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1;
  background-color: #000000;
}

/* ==================== 图片样式 ==================== */
.story-image {
  width: 100vw;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
}

.story-image-old {
  z-index: 1;
}

.story-image-new {
  z-index: 2;
}

/* ==================== 电影遮罩 ==================== */
.cinema-mask {
  position: fixed;
  left: 0;
  right: 0;
  width: 100vw;
  z-index: 90;
  pointer-events: none;
}

.cinema-mask-top {
  top: 0;
  height: 20vh;
}

.cinema-mask-bottom {
  bottom: 0;
  height: 20vh;
}
.cinema-blur {
  /* backdrop-filter: blur(8px); */
  width: 100%;
  height: 100%;
  overflow: visible;
  float: left;
  opacity: 0;
  transition: opacity 1.2s linear;
}

.cinema-mask.show .cinema-blur {
  opacity: 1;
}

.cinema-mask-top .cinema-blur {
  -webkit-mask-image: linear-gradient(#000, #000, transparent);
}

.cinema-mask-bottom .cinema-blur {
  -webkit-mask-image: linear-gradient(transparent, #000, #000);
}
.cinema-gradient {
  position: absolute;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  float: left;
  opacity: 0;
  transition: opacity 1.2s linear;
}

.cinema-mask.show .cinema-gradient {
  opacity: 1;
}

.cinema-gradient-top {
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 100%);
}

.cinema-gradient-bottom {
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0) 100%);
}

/* ==================== 文案区域 ==================== */
.story-content {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 200;
  pointer-events: none;
}
.story-title {
  position: absolute;
  left: 0;
  width: 100%;
  padding: 0 8vw;
  box-sizing: border-box;
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 2rpx;
  line-height: 1.5;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  opacity: 0;
  transform: translateY(-50%) translateY(-8px);
  transition: opacity 0.5s ease-out,
              transform 0.5s ease-out;
}

.story-title.show {
  opacity: 1;
  transform: translateY(-50%) translateY(0);
  transition: opacity 1.2s linear,
              transform 1.2s ease-out;
}

/* ==================== 文字类型系统 ==================== */
.story-text-area {
  position: absolute;
  bottom: 8vh;
  left: 0;
  width: 100%;
  padding: 0 8vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.sentence-container {
  display: block;
  line-height: 1.8;
}
.text-segment {
  display: inline;
  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.9);
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.5s ease-out, transform 0.5s ease-out;
}

.text-segment.show {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 1.2s ease-out, transform 1.2s ease-out;
}

.type-body-primary {
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.type-body-secondary {
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.type-emphasis-number {
  font-size: 56rpx;
  font-weight: 200;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.type-emphasis-keyword {
  font-size: 36rpx;
  font-weight: 200;
  letter-spacing: 2rpx;
}

/* 颜色系统 */
.color-white-pure {
  color: rgba(255, 255, 255, 1.0);
}

.color-white-primary {
  color: rgba(255, 255, 255, 0.92);
}

.color-white-secondary {
  color: rgba(255, 255, 255, 0.75);
}

.color-white-tertiary {
  color: rgba(255, 255, 255, 0.65);
}

/* ==================== 动画关键帧 ==================== */
@keyframes openingImageFadeIn {
  from {
    opacity: 0;
    filter: blur(90px) brightness(0.4);
    transform: scale(1.3);
  }
  to {
    opacity: 1;
    filter: blur(0px) brightness(1);
    transform: scale(1);
  }
}
@keyframes gradientSlide {
  0% {
    transform: translateX(-65%);
    opacity: 1;
  }
  100% {
    transform: translateX(0);
    opacity: 0;
  }
}
