/* pages/story/story.wxss - 画廊式设计 */

/* ===== 全局样式 ===== */
page {
  height: 100%;
  overflow: hidden;
  background: #0a0a0a;
  color: #fff;
}

/* ===== 容器 ===== */
.gallery-container {
  position: relative;
  height: 100vh; /* 使用vh确保占满屏幕 */
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 毛玻璃背景 ===== */
.blur-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(10, 10, 26, 1), rgba(18, 18, 35, 1));
}

.bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(60rpx) brightness(0.5) contrast(1.1);
  transform: scale(1.15); /* 增加模糊范围，避免边缘白边 */
  animation: subtleZoom 20s ease-in-out infinite alternate;
}

.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(10, 10, 16, 0.85), rgba(15, 15, 25, 0.65));
}

@keyframes subtleZoom {
  0% {
    transform: scale(1.15) translateX(-10rpx);
  }
  100% {
    transform: scale(1.25) translateX(10rpx);
  }
}

/* ===== 文案展示区 ===== */
.copywriting-section {
  flex: none; /* 改为固定高度，不要弹性分配 */
  display: flex;
  align-items: flex-end; /* 文案靠底部对齐 */
  justify-content: center;
  padding: 20rpx 40rpx 60rpx; /* 增加底部padding，让文字不要完全贴底 */
  margin-bottom: 30rpx; /* 增加底部边距，与视频卡片拉开距离 */
  z-index: 1;
  height: 28vh; /* 适中高度，不要太占空间 */
}

.copywriting-content {
  max-width: 680rpx;
  text-align: center;
  position: relative;
}

.copywriting-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #ffffff;
  font-style: normal;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.6);
  letter-spacing: 0.008em;
  font-weight: 350; /* 稍细 */
  padding: 8rpx 0;
  opacity: 0;
  animation:
    textReveal 2s cubic-bezier(0.22, 0.61, 0.36, 1) forwards,
    textFloat 2s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
}

/* 逐字显现效果 */
@keyframes textReveal {
  0% {
    opacity: 0;
    clip-path: inset(0 100% 0 0);
  }
  50% {
    opacity: 0.95;
  }
  100% {
    opacity: 0.95;
    clip-path: inset(0 0 0 0);
  }
}

/* 配合轻微上浮效果 */
@keyframes textFloat {
  from {
    transform: translateY(15rpx);
    filter: blur(2rpx);
  }
  to {
    transform: translateY(0);
    filter: blur(0);
  }
}

/* ===== 视频区域 ===== */
.video-section {
  position: relative;
  z-index: 2;
  flex: 1; /* 剩余空间都归视频区域 */
  display: flex;
  align-items: flex-start; /* 视频卡片在区域内顶部对齐 */
  margin-top: 20rpx; /* 增加顶部边距，与文案保持距离 */
  padding: 0 40rpx 80rpx; /* 底部增加padding，考虑iPhone底部横条 */
}

/* ===== 视频卡片 ===== */
.video-card {
  position: relative;
  width: 100%;
  height: 100%; /* 视频卡片填满视频区域 */
  background: linear-gradient(160deg, rgba(25, 25, 35, 0.98), rgba(30, 30, 40, 0.88));
  border-radius: 38rpx 38rpx 38rpx 38rpx; /* 所有角都设置圆角 */
  overflow: hidden;
  box-shadow:
    0 -10rpx 60rpx rgba(0, 0, 0, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1),
    inset 0 0 0 1rpx rgba(212, 175, 55, 0.12);
  animation: cardFloat 6s ease-in-out infinite alternate;
}

@keyframes cardFloat {
  0% {
    transform: translateY(4rpx) rotateX(0);
    box-shadow:
      0 -10rpx 60rpx rgba(0, 0, 0, 0.35),
      inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  }
  100% {
    transform: translateY(-2rpx) rotateX(0.3deg);
    box-shadow:
      0 -15rpx 70rpx rgba(0, 0, 0, 0.45),
      0 0 30rpx rgba(212, 175, 55, 0.02),
      inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  }
}

.video-player {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== 视频占位符（调试用） ===== */
.video-placeholder {
  width: 100%;
  height: 100%;
  background: #000000;
}

/* ===== 遮罩层 ===== */
.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 10, 16, 0.92);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.6s ease-out;
  box-shadow: inset 0 0 0 1px rgba(212, 175, 55, 0.2);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 操作按钮 ===== */
.action-buttons {
  display: flex;
  gap: 40rpx;
}

.action-btn {
  min-width: 180rpx;
  height: 90rpx;
  border: none;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.action-btn:active {
  transform: scale(0.95);
}

.replay-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.replay-btn:active {
  background: rgba(255, 255, 255, 0.2);
}

.collect-btn {
  background: linear-gradient(135deg, #d4af37, #b8941f);
  color: #0a0a0a;
  box-shadow:
    0 10rpx 30rpx rgba(212, 175, 55, 0.35),
    0 0 25rpx rgba(212, 175, 55, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
  position: relative;
  overflow: hidden;
}

.collect-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
  transition: left 0.6s;
}

.collect-btn:active::before {
  left: 100%;
}

.collect-btn:active {
  background: linear-gradient(135deg, #b8941f, #9a7c17);
  box-shadow:
    0 6rpx 18rpx rgba(212, 175, 55, 0.25),
    0 0 15rpx rgba(212, 175, 55, 0.08),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.1);
  transform: scale(0.95);
}


/* ===== 响应式调整 ===== */
@media (min-width: 750rpx) {
  .copywriting-content {
    max-width: 600rpx;
  }

  .copywriting-text {
    font-size: 40rpx;
    line-height: 1.7;
  }

  .video-card {
    height: 100%; /* 大屏幕下仍填满视频区域 */
    border-radius: 48rpx 48rpx 48rpx 48rpx; /* 大屏幕下所有角都设置圆角 */
  }

  .action-btn {
    min-width: 200rpx;
    height: 100rpx;
    font-size: 36rpx;
  }
}