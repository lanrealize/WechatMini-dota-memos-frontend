/* pages/shop/shop.wxss */
.container {
  padding: 40rpx;
  text-align: center;
}

.container text {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 40rpx;
}

.product-list {
  margin: 40rpx 0;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: #f8f8f8;
  border-radius: 16rpx;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  background-color: #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.product-info {
  flex: 1;
  text-align: left;
}

.product-name {
  display: block;
  font-size: 32rpx;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 36rpx;
  color: #e64340;
  font-weight: bold;
}

.buy-button {
  padding: 16rpx 32rpx;
  background-color: #07c160;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
}

button {
  margin-top: 60rpx;
  background-color: #576b95;
  color: white;
}